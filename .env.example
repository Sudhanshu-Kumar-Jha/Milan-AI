# ==============================================================================
# Milan AI — Master Environment & Credentials Configuration Template
# ==============================================================================

# 1. Core Server & Database Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/milanai
JWT_SECRET=milan_dev_secret_key_2026_mindful_matrimony

# 2. Email & OTP Verification Provider (MailHog / Local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Milan AI Support" <noreply@milanai.com>
MAILHOG_WEB_URL=http://localhost:8025
DEFAULT_TEST_OTP=123456

# 3. SMS & OTP Verification Provider (Twilio - Optional Fallback)
SMS_PROVIDER=default
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# 4. AI Compatibility & Safety Agent Provider (Gemini / OpenAI)
AI_PROVIDER=default
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# 5. Payment Gateway (Razorpay / Stripe)
PAYMENT_PROVIDER=default
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_SECRET_KEY=your_stripe_secret_key

# 6. Client & Application URLs
CLIENT_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5000/api
