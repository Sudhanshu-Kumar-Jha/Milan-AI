# ==============================================================================
# Milan AI — Master Environment & Credentials Configuration Template
# ==============================================================================

# 1. Core Server & Database Configuration
NODE_ENV=development
PORT=5000

# Primary Database Connection:
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/milanai
# MongoDB Atlas Cloud (Replace <db_password> with your Atlas user password):
# MONGODB_URI=mongodb+srv://sudhanshujha0111_db_user:<db_password>@milanai.te8q73a.mongodb.net/milanai?retryWrites=true&w=majority&appName=MilanAI

JWT_SECRET=your_jwt_secret_key_here

# 2. Mail & OTP Service (Real Gmail SSL SMTP)
# Note: MAIL_PASSWORD must be a 16-character Google App Password (not your personal password)
MAIL_DRIVER=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=no.reply.milanai@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no.reply.milanai@gmail.com
MAIL_FROM_NAME="Milan AI"

# 3. AI Compatibility & Safety Agent Provider (Gemini / OpenAI)
AI_PROVIDER=default
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# 4. Payment Gateway (Razorpay / Stripe)
PAYMENT_PROVIDER=default
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# 5. Client & Application URLs
CLIENT_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5000/api

